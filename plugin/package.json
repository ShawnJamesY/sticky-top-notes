{
  "name": "@shawnjamesy/dsh-sticky-top-notes",
  "version": "1.3.0",
  "private": true,
  "description": "A fixed 20px sticky-note strip at the top of the DSH chat panel: quick entry, one-click complete with timestamps, view-all panel with txt export. Human-facing only — never enters the model context.",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": ["dsh", "deepseek-harness", "cordis", "plugin", "bundle", "sticky-notes", "todo", "reminder"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.zh.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
